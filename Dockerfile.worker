# ---------- stage 1: build ----------
FROM python:3.12-slim AS builder

WORKDIR /build
COPY requirements/base.txt   requirements/base.txt
COPY requirements/worker.txt requirements/worker.txt

RUN pip install --no-cache-dir --prefix=/install -r requirements/worker.txt

# ---------- stage 2: runtime ----------
FROM python:3.12-slim

# tini gives us a real PID 1: forwards SIGTERM to the Python process so the
# drain in worker.main actually runs, and reaps zombies on shutdown.
RUN apt-get update \
    && apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/*

# Security: non-root user
RUN groupadd -r app && useradd -r -g app -d /app -s /sbin/nologin app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY --from=builder /install /usr/local

# No main.py: the worker has its own entrypoint. It does need domain/ (the
# snapshot lives there) and locales/ (error keys resolve through the same
# registry). document-templates/ is deliberately absent — the bundles are served
# from object storage to document-generation, never read here.
#
# api/ is NOT here: nothing the worker runs lives under it since the July
# deadline sweep (which ran the API's service) was replaced by the engine's
# daily jobs. This image installs requirements/worker.txt, which has no
# fastapi/uvicorn, so a worker module that reaches something importing fastapi
# kills the container at startup with ModuleNotFoundError — which once shipped
# and crash-looped. That is why the port provider lives in ports/providers.py
# and why the upload cap lives in shared/const.py. Pinned by
# tests/test_worker_import_graph.py, which also refuses a worker import of api/.
#
# engine/ and regulators/ are the procedures engine and its plugins; the
# plugins' YAML catalogues and calendars travel inside regulators/ and are
# read (and synced to the database) at startup.
COPY core/       core/
COPY domain/     domain/
COPY engine/     engine/
COPY ports/      ports/
COPY regulators/ regulators/
COPY shared/     shared/
COPY worker/     worker/
COPY locales/    locales/

RUN chown -R app:app /app
USER app

# Liveness: worker.main touches /tmp/worker.alive every ~15 s while the event
# loop is responsive. ~3 missed touches = unhealthy. start-period covers the
# bounded NATS connect retry window plus subscription setup.
HEALTHCHECK --interval=30s --timeout=5s --start-period=600s --retries=3 \
    CMD python -c "import os, time, sys; sys.exit(0 if time.time() - os.path.getmtime('/tmp/worker.alive') < 60 else 1)"

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "-m", "worker.main"]
