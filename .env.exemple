# Template for local development — copy to .env.local (ENV defaults to "local").
# The real settings contract lives in core/config.py.

# ── Core ──
ENV=local

# ── CRM database (read-only here: communities, members, meters, subscriptions, audit log) ──
CRM_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crm_db
CRM_DB_POOL_SIZE=20
CRM_DB_MAX_OVERFLOW=10
CRM_DB_POOL_RECYCLE=3600
CRM_DB_POOL_TIMEOUT=30
CRM_DB_SSL=false

# ── Local database (dossiers, documents, versions, status journal, deadlines) ──
LOCAL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/administrative_document_local
LOCAL_DB_POOL_SIZE=20
LOCAL_DB_MAX_OVERFLOW=10
LOCAL_DB_POOL_RECYCLE=3600
LOCAL_DB_POOL_TIMEOUT=30
LOCAL_DB_SSL=false

# ── NATS ──
NATS_URL=nats://localhost:4222

# ── Storage (S3-compatible, MinIO in dev) ──
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=crm-files
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
# Bucket holding stored document versions (uploaded evidence now, docgen-rendered
# annexes in Phase 2). Shared with billing's rendered PDFs; this service writes
# under the `administrative-document/` key prefix and needs read+write on it.
OUTPUT_BUCKET=optimce-documents

# --- Rendering bundles + document-generation -------------------------------
# This service never opens a bundle: document_template.file_ref points into
# TEMPLATES_BUCKET and document-generation fetches it. Declared so a
# misconfigured stack fails at boot rather than on the first render.
TEMPLATES_BUCKET=optimce-templates
# document-generation's request subject, and OUR reply subject. The result
# arrives on the latter; it must match what the worker subscribes to.
DOCGEN_REQUEST_SUBJECT=docgen.request
DOCGEN_RESULT_SUBJECT=docgen.result.administrative_document
DOCGEN_PRESIGN_TTL=3600
# How long a PENDING render may sit before a new request may supersede it.
# Without it a result lost to docgen's DLQ would wedge the document forever.
RENDER_STALE_AFTER_SECONDS=1800

# ── Regulator registry ──
# Points at the SHARED reference/regulators.json, which maps community.regulator
# to the region whose deadline rules and templates apply. Empty in the dev
# monorepo (falls back to ../reference/regulators.json); REQUIRED in a container
# (mount the file and set this) — an unresolvable registry fails every dossier.
REGULATORS_CONFIG_PATH=

# ── CORS ──
ALLOW_ORIGIN=*

# ── Observability (optional in local) ──
LOGGING_TOKEN=
LOGGING_TRACES_URL=
LOGGING_LOGS_URL=
LOGGING_METRICS_URL=
