# Template for .env.staging — copy to .env.staging and fill in real values.
# Pydantic will refuse to start the service if any required key below is missing.

# ── Core ──
ENV=staging

# ── CRM Database ──
CRM_DATABASE_URL=postgresql+asyncpg://user:password@crm-db.staging.internal/optimce
CRM_DB_SSL=true

# ── LOCAL Database ──
LOCAL_DATABASE_URL=postgresql+asyncpg://user:password@local-db.staging.internal/administrative_documents
LOCAL_DB_SSL=true

# ── NATS ──
NATS_URL=nats://nats.staging.internal:4222

# ── Storage (S3-compatible, e.g. MinIO) ──
STORAGE_ENDPOINT=https://storage.staging.internal
STORAGE_BUCKET=crm-files
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
# Stored document versions. Shared with billing's rendered PDFs; this service
# writes under the `administrative-document/` key prefix (read+write required).
OUTPUT_BUCKET=optimce-documents

# --- Rendering bundles + document-generation -------------------------------
# This service never opens a bundle: document_template.file_ref points into
# TEMPLATES_BUCKET and document-generation fetches it. Declared so a
# misconfigured stack fails at boot rather than on the first render.
TEMPLATES_BUCKET=optimce-templates
# document-generation's request subject, and OUR reply subject. The result
# arrives on the latter; it must match what the worker subscribes to.
DOCGEN_REQUEST_SUBJECT=docgen.request
DOCGEN_RESULT_SUBJECT=docgen.result.administrative_document
DOCGEN_PRESIGN_TTL=3600
# How long a PENDING render may sit before a new request may supersede it.
# Without it a result lost to docgen's DLQ would wedge the document forever.
RENDER_STALE_AFTER_SECONDS=1800

# ── Regulator registry ──
# REQUIRED in a container: mount the shared reference/regulators.json and point
# this at it. It maps community.regulator to the region whose deadline rules and
# templates apply, so an unresolvable registry fails every dossier creation.
REGULATORS_CONFIG_PATH=/config/regulators.json

# ── CORS ──
# Comma-separated list of allowed origins. Wildcards ("*") are rejected at startup.
# Document the real frontend / gateway origin(s) here.
ALLOW_ORIGIN=https://app.staging.optimce.example

# ── Observability (optional in staging, required in production) ──
LOGGING_TOKEN=
LOGGING_TRACES_URL=
LOGGING_LOGS_URL=
LOGGING_METRICS_URL=
