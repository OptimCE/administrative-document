# Loaded by core/config.py when ENV=test is exported (e.g. by tests/conftest.py).
# Single Postgres instance on port 5433 — both CRM and LOCAL test data live in
# the same database `test_db_be` declared in tests/docker-compose.test.yml.

# ── Core ──
ENV=test

# ── CRM database (mirrored CRM tables created by tests/sql/crm_test_schema.sql) ──
CRM_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/test_db_be
CRM_DB_POOL_SIZE=5
CRM_DB_MAX_OVERFLOW=2
CRM_DB_POOL_RECYCLE=3600
CRM_DB_POOL_TIMEOUT=10
CRM_DB_SSL=false

# ── Local database (schema applied from scripts/sql/schema.sql) ──
LOCAL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/test_db_be
LOCAL_DB_POOL_SIZE=5
LOCAL_DB_MAX_OVERFLOW=2
LOCAL_DB_POOL_RECYCLE=3600
LOCAL_DB_POOL_TIMEOUT=10
LOCAL_DB_SSL=false

# ── NATS ──
# Empty: workers are not initialised under tests; NATS clients are mocked.
NATS_URL=

# ── Storage ──
# Placeholders only — tests mock core.storage entirely; nothing real is contacted.
STORAGE_ENDPOINT=http://localhost:9999
STORAGE_BUCKET=test-bucket
STORAGE_ACCESS_KEY=test-access
STORAGE_SECRET_KEY=test-secret
STORAGE_REGION=us-east-1
OUTPUT_BUCKET=test-documents

# --- Rendering bundles + document-generation -------------------------------
# This service never opens a bundle: document_template.file_ref points into
# TEMPLATES_BUCKET and document-generation fetches it. Declared so a
# misconfigured stack fails at boot rather than on the first render.
TEMPLATES_BUCKET=test-templates
# document-generation's request subject, and OUR reply subject. The result
# arrives on the latter; it must match what the worker subscribes to.
DOCGEN_REQUEST_SUBJECT=docgen.request
DOCGEN_RESULT_SUBJECT=docgen.result.administrative_document
DOCGEN_PRESIGN_TTL=3600
# How long a PENDING render may sit before a new request may supersede it.
# Without it a result lost to docgen's DLQ would wedge the document forever.
RENDER_STALE_AFTER_SECONDS=1800

# ── Regulator registry ──
# Deliberately NOT set here. tests/conftest.py exports REGULATORS_CONFIG_PATH as
# an absolute path to tests/fixtures/regulators.json (env wins over this file),
# because a path written here would be relative to the working directory.

# ── CORS ──
ALLOW_ORIGIN=http://localhost

# ── Observability ──
# Empty: tracing/metrics exporters are no-ops without endpoints.
LOGGING_TOKEN=
LOGGING_TRACES_URL=
LOGGING_LOGS_URL=
LOGGING_METRICS_URL=
